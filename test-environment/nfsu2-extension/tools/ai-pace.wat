(module (import "env" "memory" (memory 256 65536 shared)) (import "env" "original" (func $original (param i32)))(import "env" "catchup" (func $catchup (param i32))) (func (export "step") (param $cpu i32) (local $driver i32) (local $player i32) (local $car i32) (local $race i32) (local $seq i32) (local $percent i32) (local $native f32) 
 ;; The stock port wrapper saves ECX before the native update changes it.
 (local.set $driver (i32.load offset=4 (local.get $cpu)))
 (call $original (local.get $cpu))
 (call $catchup (local.get $driver))
 (block $done
  (br_if $done (i32.ne (i32.load (i32.const 13684992)) (i32.const 927547726)))
  (br_if $done (i32.ne (i32.load (i32.const 13685020)) (i32.const 927547726)))
  (local.set $seq (i32.load (i32.const 13684996)))
  (br_if $done (i32.and (local.get $seq) (i32.const 1)))
  (br_if $done (i32.ge_u (i32.load (i32.const 13685040)) (i32.const 180)))
  (br_if $done (i32.eqz (i32.and (i32.ge_u (i32.load (i32.const 13685000)) (i32.const 1)) (i32.le_u (i32.load (i32.const 13685000)) (i32.const 2)))))
  (br_if $done (i32.ne (i32.load (i32.const 13685044)) (i32.const 1)))
  (br_if $done (i32.ne (i32.load (i32.const 8803492)) (i32.const 6)))
  (br_if $done (i32.ne (i32.load (i32.const 13631536)) (i32.const 1)))
  ;; Only this extension's online guard is optional. Native network state stays untouched.
  (if (i32.ne (i32.load (i32.const 13685076)) (i32.const 1)) (then
   (br_if $done (i32.and (i32.load (i32.const 8716408)) (i32.const 520)))
   (br_if $done (i32.load (i32.const 8808980)))
   (br_if $done (i32.load (i32.const 8808948)))
   (br_if $done (i32.load8_u (i32.const 0x89cf69)))))
  (br_if $done (i32.load8_u (i32.const 0x89e7d8)))
  (local.set $player (i32.load (i32.const 13631488)))
  (br_if $done (i32.eqz (i32.and (i32.ge_u (local.get $player) (i32.const 65536)) (i32.and (i32.lt_u (local.get $player) (i32.const 0x27fff000)) (i64.lt_u (i64.extend_i32_u (local.get $player)) (i64.sub (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)) (i64.const 4096)))))))
  (br_if $done (i32.ne (local.get $player) (i32.load (i32.const 13685024))))
  (br_if $done (i32.ne (local.get $player) (i32.load (i32.const 13685004))))
  (br_if $done (i32.load offset=16 (local.get $player)))
  (local.set $car (i32.load offset=4 (local.get $player)))
  (br_if $done (i32.eqz (i32.and (i32.ge_u (local.get $car) (i32.const 65536)) (i32.and (i32.lt_u (local.get $car) (i32.const 0x27fff000)) (i64.lt_u (i64.extend_i32_u (local.get $car)) (i64.sub (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)) (i64.const 4096)))))))
  (br_if $done (i32.ne (local.get $car) (i32.load (i32.const 13685028))))
  (br_if $done (i32.ne (local.get $car) (i32.load (i32.const 13685008))))
  (br_if $done (i32.ne (i32.load offset=36 (local.get $car)) (i32.const 3)))
  (br_if $done (i32.eqz (i32.and (i32.ge_u (local.get $driver) (i32.const 65536)) (i32.and (i32.lt_u (local.get $driver) (i32.const 0x27fff000)) (i64.lt_u (i64.extend_i32_u (local.get $driver)) (i64.sub (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)) (i64.const 4096)))))))
  ;; car+0x2c is the active driver/brain, driver+4 is its vehicle.
  (br_if $done (i32.ne (i32.load offset=44 (local.get $car)) (local.get $driver)))
  (br_if $done (i32.ne (i32.load offset=4 (local.get $driver)) (local.get $car)))
  (local.set $race (i32.load (i32.const 8978712)))
  (br_if $done (i32.eqz (i32.and (i32.ge_u (local.get $race) (i32.const 65536)) (i32.and (i32.lt_u (local.get $race) (i32.const 0x27fff000)) (i64.lt_u (i64.extend_i32_u (local.get $race)) (i64.sub (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)) (i64.const 4096)))))))
  (br_if $done (i32.ne (local.get $race) (i32.load (i32.const 13685032))))
  (br_if $done (i32.ne (local.get $race) (i32.load (i32.const 13685012))))
  (br_if $done (i32.ne (i32.load (local.get $race)) (i32.const 4)))
  (local.set $percent (i32.load (i32.const 13685052)))
  (br_if $done (i32.eqz (i32.and (i32.ge_u (local.get $percent) (i32.const 75)) (i32.le_u (local.get $percent) (i32.const 300)))))
  (local.set $native (f32.load offset=1904 (local.get $driver)))
  ;; Comparisons reject NaN/Inf and unexpected layouts without touching them.
  (br_if $done (i32.eqz (i32.and (f32.ge (local.get $native) (f32.const 0)) (f32.le (local.get $native) (f32.const 4)))))
  (br_if $done (i32.ne (local.get $seq) (i32.load (i32.const 13684996))))
  ;; Original recomputes this each update: never multiply our previous result.
  ;; Keep the ordinary 1x path bit-for-bit untouched, including negative zero.
  (if (i32.ne (local.get $percent) (i32.const 100))
   (then (f32.store offset=1904 (local.get $driver)
    (f32.mul (local.get $native) (f32.div (f32.convert_i32_u (local.get $percent)) (f32.const 100))))))
  (i32.store (i32.const 13685068) (local.get $percent))
  (i32.store (i32.const 13685072) (i32.add (i32.load (i32.const 13685072)) (i32.const 1)))
 )))